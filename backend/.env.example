PROMOBOX_USERNAME=
PROMOBOX_PASSWORD=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=BalkanWarehouse <onboarding@resend.dev>
ORDER_NOTIFICATION_EMAIL=
ADMIN_PASSWORD=
# The frontend's own origin - the backend only accepts requests from this
# origin. Defaults to http://localhost:5173 for local dev; set this to the
# real deployed domain (e.g. https://balkanwarehouse.rs) in production.
FRONTEND_ORIGIN=

# Where ads.json/settings.json and uploaded ad images are stored. Defaults
# to a local backend/data folder, which is fine for local dev but does NOT
# survive a Render free-plan redeploy/restart/spin-down. On Render, once a
# persistent Disk is attached, set this to its mount path (e.g. /var/data)
# so this data actually persists.
DATA_DIR=

# NestPay (Banca Intesa) card payment - test/pilot environment values.
# NESTPAY_TEST_CLIENT_ID is the Merchant ID from the bank's credentials
# email. NESTPAY_TEST_STORE_KEY is one you set yourself in the test Merchant
# Center's Administration tab, never given to you by the bank. Swap all
# for their production equivalents once you go live.
NESTPAY_TEST_CLIENT_ID=
NESTPAY_TEST_STORE_KEY=
NESTPAY_TEST_GATEWAY_URL=https://testsecurepay.eway2pay.com/fim/est3Dgate

# Same test Merchant Center login (User Name/Password) from the bank's
# credentials email - used only for the separate capture/void/refund API
# (POST /fim/api), not the payment redirect above, which uses the StoreKey
# instead.
NESTPAY_TEST_USERNAME=
NESTPAY_TEST_PASSWORD=
NESTPAY_TEST_API_URL=https://testsecurepay.eway2pay.com/fim/api

# The backend's own public URL, used to build the okUrl/failUrl NestPay
# redirects the customer back to after paying. Defaults to
# http://localhost:<PORT> for local dev; set this to the real deployed
# backend URL (e.g. https://balkanwarehouse.onrender.com) in production.
PUBLIC_BACKEND_URL=
